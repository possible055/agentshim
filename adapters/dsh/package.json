{
  "name": "dsh-agentshim",
  "description": "DSH native tool plugin backed by agentshim-core",
  "version": "0.1.6-alpha.2",
  "agentshimNativeApi": 5,
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-agentshim-captures": "./lib/capture-cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "README.zh-CN.md",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint src tests scripts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:platform": "vitest run --project native tests/native.spec.ts",
    "test:composition": "vitest run --project native tests/assembly.spec.ts tests/composition.spec.ts",
    "test:e2e": "vitest run --project native tests/real-server.e2e.ts",
    "test:long": "vitest run --project native tests/real-server.e2e.ts -t \"keeps a DSH bash call alive past 60 seconds\"",
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test:packed": "node scripts/test-packed.mjs",
    "test:packed:matrix": "node scripts/test-packed.mjs --matrix",
    "test:release-packages": "node scripts/test-release-packages.mjs",
    "verify:cutover": "node scripts/verify-cutover.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "optionalDependencies": {
    "dsh-agentshim-darwin-arm64": "workspace:0.1.6-alpha.2",
    "dsh-agentshim-linux-arm64-gnu": "workspace:0.1.6-alpha.2",
    "dsh-agentshim-linux-x64-gnu": "workspace:0.1.6-alpha.2",
    "dsh-agentshim-win32-x64-msvc": "workspace:0.1.6-alpha.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "0.1.5-alpha.1 || 0.1.5-alpha.2 || 0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.6-alpha.1 || 0.1.6-alpha.2",
    "@deepseek-ai/dsh-fs": "0.1.5-alpha.1 || 0.1.5-alpha.2 || 0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.6-alpha.1 || 0.1.6-alpha.2",
    "@deepseek-ai/dsh-fs-local": "0.1.5-alpha.1 || 0.1.5-alpha.2 || 0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.6-alpha.1 || 0.1.6-alpha.2",
    "@deepseek-ai/dsh-jobs": "0.1.5-alpha.1 || 0.1.5-alpha.2 || 0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.6-alpha.1 || 0.1.6-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.5-alpha.1 || 0.1.5-alpha.2 || 0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.6-alpha.1 || 0.1.6-alpha.2",
    "@deepseek-ai/dsh-sandbox": "0.1.5-alpha.1 || 0.1.5-alpha.2 || 0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.6-alpha.1 || 0.1.6-alpha.2",
    "@deepseek-ai/dsh-shell": "0.1.5-alpha.1 || 0.1.5-alpha.2 || 0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.6-alpha.1 || 0.1.6-alpha.2",
    "@deepseek-ai/dsh-subprocess": "0.1.5-alpha.1 || 0.1.5-alpha.2 || 0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.6-alpha.1 || 0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.5-alpha.1 || 0.1.5-alpha.2 || 0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.6-alpha.1 || 0.1.6-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-attachment-local": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-fs": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-fs-local": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-fs-observation-policy": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-jobs": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-jobs-local": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-ptc-runtime": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-ptc-runtime-node": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-sandbox": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-scope": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-shell": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-subprocess": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-subprocess-local": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-tool-call-timeout-policy": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-tool-jobs": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.2",
    "@types/node": "^22.20.0",
    "oxlint": "^1.76.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
