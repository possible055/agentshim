{
  "name": "dsh-agentshim",
  "description": "DSH native tool plugin backed by a private agentshim MCP session",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint src tests",
    "test": "vitest run",
    "test:package-smoke": "vitest run tests/package-smoke.e2e.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-fs": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-fs-local": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-sandbox": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-shell": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.6",
    "@deepseek-ai/dsh-attachment-local": "0.1.0-rc.6",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.6",
    "@deepseek-ai/dsh-fs-local": "0.1.0-rc.6",
    "@deepseek-ai/dsh-fs-observation-policy": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.6",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-call-timeout-policy": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@types/node": "^22.20.0",
    "oxlint": "^1.76.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
