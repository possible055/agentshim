{
  "name": "dsh-agentshim",
  "description": "DSH native tool plugin backed by agentshim-core",
  "version": "0.1.4",
  "agentshimNativeApi": 5,
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-agentshim-captures": "./lib/capture-cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint src tests scripts",
    "test": "vitest run",
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test:packed": "node scripts/test-packed.mjs",
    "test:release-packages": "node scripts/test-release-packages.mjs",
    "verify:cutover": "node scripts/verify-cutover.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "optionalDependencies": {
    "dsh-agentshim-darwin-arm64": "workspace:0.1.4",
    "dsh-agentshim-linux-arm64-gnu": "workspace:0.1.4",
    "dsh-agentshim-linux-x64-gnu": "workspace:0.1.4",
    "dsh-agentshim-win32-x64-msvc": "workspace:0.1.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.6 || 0.1.0-rc.7",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.6 || 0.1.0-rc.7",
    "@deepseek-ai/dsh-fs-local": "0.1.0-rc.6 || 0.1.0-rc.7",
    "@deepseek-ai/dsh-jobs": "0.1.0-rc.6 || 0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6 || 0.1.0-rc.7",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.6 || 0.1.0-rc.7",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.6 || 0.1.0-rc.7",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.6 || 0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6 || 0.1.0-rc.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.7",
    "@deepseek-ai/dsh-attachment-local": "0.1.0-rc.7",
    "@deepseek-ai/dsh-code-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "0.1.0-rc.7",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.7",
    "@deepseek-ai/dsh-fs-local": "0.1.0-rc.7",
    "@deepseek-ai/dsh-fs-observation-policy": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-jobs": "0.1.0-rc.7",
    "@deepseek-ai/dsh-jobs-local": "0.1.0-rc.7",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.7",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.7",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tool-call-timeout-policy": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tool-jobs": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@types/node": "^22.20.0",
    "oxlint": "^1.76.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
