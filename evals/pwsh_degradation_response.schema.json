{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tool", "arguments"],
        "properties": {
          "id": {
            "type": "string"
          },
          "tool": {
            "type": "string",
            "enum": [
              "read",
              "grep",
              "glob",
              "run_program",
              "bash",
              "unsupported"
            ]
          },
          "arguments": {
            "type": "object"
          }
        }
      }
    }
  }
}
