{
  "$id": "https://agentshim.dev/contracts/generated/dsh-tools-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descriptions": {
    "bash": "Run non-interactive POSIX Bash and return merged output plus exit status. Process access is independent from read scope. MCP long work uses detach=true with a repository-local log_path, then bash_status; DSH long work uses run_in_background=true, requires a short description, then bash_status.",
    "bash_status": "Inspect the lifecycle and final outcome of the job ID returned by a background bash call; MCP returns bounded log pages while DSH returns the official job snapshot. Repeat until terminal status.",
    "glob": "Find files or directories with a bounded case-sensitive glob. Use an array for include/exclude patterns and continue Partial: next_offset=N with offset. Read scope defaults to unrestricted; normal scope permits the session root and approved extension roots.",
    "grep": "Search files with Rust regex, or literal text with fixed_strings=true. Narrow with glob/type/mode and continue Partial: next_offset=N with offset. Read scope defaults to unrestricted; normal scope permits the session root and approved extension roots.",
    "read": "Read one file as numbered lines. Use PDF pages/pdf_mode or Office cursors for structured documents; pass Partial: next_start_line=N as start_line to continue. Read scope defaults to unrestricted; normal scope permits the session root and approved extension roots.",
    "run_program": "Run one executable with literal argv and no shell. A nonzero exit is returned with its status and output; process access is independent from read scope. Use bash for pipelines, redirection, or shell composition."
  },
