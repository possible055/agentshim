[mcp_servers.codexshim]
command = 'C:\absolute\path\to\codexshim.exe'
args = ["serve"]
# Normal mode includes repository and Codex skill/plugin paths. To allow other
# absolute read/grep/glob paths on fixed NTFS volumes, use:
# args = ["serve", "--read-scope", "unrestricted"]
required = true
supports_parallel_tool_calls = true
startup_timeout_sec = 15
tool_timeout_sec = 610
enabled_tools = ["read", "grep", "glob", "run_program", "bash"]
default_tools_approval_mode = "writes"
# CODEXSHIM_OUTPUT_BYTES raises the per-call output ceiling; 4096-262144, default 32000.
env = { CODEX_MCP_PROTOCOL_VERSION = "2026-07-28" }

# run_program takes one executable and literal argv, so it can be approved on request.
[mcp_servers.codexshim.tools.run_program]
approval_mode = "on-request"

# bash takes an arbitrary command line, so it always prompts.
[mcp_servers.codexshim.tools.bash]
approval_mode = "prompt"

[features]
shell_tool = true
mcp_2026_07_28 = true
